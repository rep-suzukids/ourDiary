# Browser and Vercel Function authentication
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Local development PostgreSQL only (never use a Neon host here)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=ourdiary
POSTGRES_USER=ourdiary
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=false

# Vercel Preview / Production only; injected by the Neon integration
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google Drive API (server only)
# Generate the encryption key once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/google-drive-callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=replace-with-a-32-byte-base64-value
# Service account used only to read the shared album folder.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=our-diary-reader@your-project.iam.gserviceaccount.com
# Keep the surrounding quotes. Vercel may store this as a multiline value or with literal \n characters.
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APP_BASE_URL=http://localhost:3000
