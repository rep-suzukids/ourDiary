# Browser and Vercel Function authentication
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Local development PostgreSQL only (never use a Neon host here)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=ourdiary
POSTGRES_USER=ourdiary
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=false

# Vercel Preview / Production only; injected by the Neon integration
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
